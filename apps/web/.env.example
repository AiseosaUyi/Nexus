# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# AI bubble menu
OPENAI_API_KEY=

# App URL — used for invite links and as the Nexus Brain MCP OAuth issuer/resourceUrl
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Nexus Brain MCP — OAuth 2.1 authorization server (apps/web/src/lib/oauth/*)
# 32+ random bytes, base64. Required for OAuth; /api/oauth/token returns a
# clean 500 when unset rather than silently minting unsigned tokens.
NEXUS_MCP_OAUTH_JWT_SECRET=

# Nexus Brain MCP — integration secret encryption (apps/web/src/lib/crypto/secretbox.ts)
# 32 bytes, base64. Required to save a Gruve API key from Connections settings.
NEXUS_INTEGRATION_KEY=

# Nexus Brain MCP — legacy bridge, optional. Set to "1" only during migration
# off the old ?key=-in-URL /api/mcp connector; delete once Cowork reconnects
# via OAuth. Only read when this flag is set (and by /api/command, unchanged).
MCP_LEGACY_COMMAND_TOKEN=

# Command Center — existing, pre-dates the Nexus Brain MCP build
COMMAND_CENTER_TOKEN=
COMMAND_CENTER_BUSINESS_SLUG=

# Optional — email (Resend)
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional — monitoring
SENTRY_DSN=
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=

# Playwright only
E2E_TEST_EMAIL=
E2E_TEST_PASSWORD=
